  "primitives": {
    "404": {
      "class": ".k-404",
      "rule": "Italic 0 is the accent moment. Plain and useful."
    },
    "button": {
      "class": ".k-btn",
      "variants": [
        "--primary",
        "--accent",
        "--secondary",
        "--ghost",
        "--sm",
        "--lg"
      ],
      "rule": "One accent per view. Accent reserved for conversion-critical."
    },
    "badge": {
      "class": ".k-badge",
      "variants": [
        "--solid",
        "--accent",
        "--soft",
        "--outline",
        "--no-dot"
      ],
      "rule": "Dot shown by default for status; strip for taxonomy tags."
    },
    "eyebrow": {
      "class": ".eyebrow",
      "variants": [
        "--accent"
      ],
      "rule": "ALL CAPS · 0.18em tracked · 24px rule prefix · max 4 words."
    },
    "card": {
      "class": ".k-card",
      "variants": [
        "--hover"
      ],
      "rule": "Paper bg · 1px rule · r-3 · s-6 padding."
    },
    "stat": {
      "class": ".k-stat",
      "rule": "One number serif + one line + source line mono."
    },
    "case-card": {
      "class": ".k-case",
      "rule": "4/3 photo · gradient scrim · meta pills · case title with em accent."
    },
    "input": {
      "class": ".k-input",
      "rule": "Label above (uppercase), focus = accent border + 3px ring @ 12%."
    },
    "select": {
      "class": ".k-select"
    },
    "textarea": {
      "class": ".k-textarea"
    },
    "checkbox": {
      "class": ".k-check",
      "rule": "Paper tick on ink · 18px hit area."
    },
    "switch": {
      "class": ".k-switch",
      "rule": "Instant-apply only. Form submits use checkbox."
    },
    "tabs-pill": {
      "class": ".k-tabs",
      "rule": "View switching · max 5."
    },
    "tabs-underline": {
      "class": ".k-tabs.k-tabs--underline",
      "rule": "Long-list filtering · accent underline on active."
    },
    "breadcrumb": {
      "class": ".k-breadcrumb",
      "rule": "Deep pages only (3+ levels). Soft slash separator."
    },
    "state-empty": {
      "class": ".k-state",
      "rule": "One italic accent word in headline · one primary action · never sad-face illustrations."
    },
    "state-error": {
      "class": ".k-state.k-state--error",
      "rule": "Name the failure plainly · include a reference code · retry is always first action."
    },
    "skeleton": {
      "class": ".k-skel",
      "rule": "Shape matches loading content · 1.4s pulse · respects prefers-reduced-motion."
    },
    "spinner": {
      "class": ".k-spinner",
      "variants": [
        "--sm",
        "--lg"
      ],
      "rule": "Rule border + accent top arc. Use sparingly — skeletons are the default."
    }
  },
  "kit-primitives": {
    "button": {
      "class": ".btn",
      "variants": [
        "--primary",
        "--accent",
        "--ghost",
        "--sm",
        "--lg"
      ],
      "rule": "Pill. Primary = ink. Accent = red, conversion only, one per view."
    },
    "chip": {
      "class": ".chip",
      "rule": "Pill, 1px rule, caps 12px, muted."
    },
    "card": {
      "class": ".card",
      "variants": [
        "--warm",
        "--link"
      ],
      "rule": "Paper, 1px rule, r-3, s-6 padding."
    },
    "eyebrow": {
      "class": ".eyebrow",
      "variants": [
        "--accent"
      ],
      "rule": "Caps 12px, 0.18em, 24px tick, max four words."
    },
    "display": {
      "class": ".display",
      "variants": [
        "--d1",
        "--d2",
        "--d3"
      ],
      "rule": "Newsreader 400; one <em> word goes italic red."
    },
    "stat": {
      "class": ".stat",
      "parts": [
        "__num",
        "__num--accent",
        "__label",
        "__source"
