{
  "cleanUrls": false,
  "redirects": [
    { "source": "/", "destination": "/project/", "type": 302 }
  ],
  "rewrites": [
    { "source": "/project", "destination": "/project/index.html" },
    { "source": "/project/", "destination": "/project/index.html" }
  ],
  "headers": [
    {
      "source": "**/*.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "**/*.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "**/*.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "project/@(kit|styles|pages|assets|downloads)/**",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "project/kit/**/*.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" }
      ]
    },
    {
      "source": "project/kit/**/*.scss",
      "headers": [
        { "key": "Content-Type", "value": "text/x-scss; charset=utf-8" }
      ]
    },
    {
      "source": "project/kit/**/*.js",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "project/downloads/*.gpl",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "project/downloads/*.ase",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"kilowott-colors.ase\"" }
      ]
    },
    {
      "source": "project/index.html",
      "headers": [
        { "key": "Link", "value": "</llms.txt>; rel=\"alternate\"; type=\"text/plain\", </AGENTS.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    }
  ]
}
