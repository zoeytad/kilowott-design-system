{
  "$description": "Kilowott brand kit v1.0: design tokens in W3C Design Tokens (DTCG) format. Generated by scripts/build-tokens.mjs from project/styles/tokens.css. Do not edit by hand: run `npm run build:tokens`.",
  "$extensions": {
    "com.kilowott": {
      "name": "Kilowott Design System",
      "version": "1.0",
      "source": "https://brandkit.kilowott.com/project/styles/tokens.css",
      "docs": "https://brandkit.kilowott.com/AGENTS.md",
      "themes": {
        "default": "light",
        "dark": "apply [data-theme=\"dark\"] on <html>; overrides live under theme.dark"
      },
      "usageRatio": {
        "paper": 60,
        "ink": 30,
        "warm": 5,
        "red": 5,
        "rule": "60·30·5·5 = paper · ink · warm paper · red"
      },
      "googleFonts": "https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap",
      "icons": {
        "library": "Lucide",
        "version": "1.66.0",
        "cdn": "https://unpkg.com/lucide@1.66.0/dist/umd/lucide.min.js",
        "strokeWidth": 1.5,
        "color": "currentColor"
      }
    }
  },
