  "tagline": {
    "primary": "Built for what comes next.",
    "long": "Scale faster. Deliver better. Create impact."
  },
  "color": {
    "_rule": "60·30·5·5 = paper · ink · warm paper · red. Paper is the surface, not red. Default theme is light. Red is a single-accent spotlight, never a background. Hex values: see tokens.colors (generated).",
    "ratio": {
      "paper": 60,
      "ink": 30,
      "warm": 5,
      "red": 5,
      "_rule": "60·30·5·5 — paper · ink · warm paper · red. Never invert."
    },
    "red_rules": [
      "One red idea per surface: the italic headline word, one stat, the primary CTA, or a thin 1–2px rule. Pick one.",
      "Never red body text. Small red text (links, inline code, labels) uses --link (red-ink #8A021B).",
      "Red buttons only for the primary conversion.",
      "Never tint, gradient, or two-tone red; never a red background wash.",
      "Never next to another saturated colour.",
      "State colours (success, warning, info) are product UI only, always with an icon and a word. Danger is brand red."
    ],
    "do": [
      "Red on the single italic emphasis word in a serif headline",
      "Red on one statistic per surface",
      "Red as a 1–2px rule under an eyebrow or above a footer",
      "Red as a 4mm rule on print (business cards, envelopes)",
      "Red as the primary CTA fill when nothing else on the surface is red",
      "Ink (#0B0F14) as body colour on light surfaces",
      "Warm paper (#F6F4F0) for section breaks and cards on paper"
    ],
    "dont": [
      "Red as a full-page or full-section background",
      "Red as body text or large blocks of text",
      "Red gradients or two-tone reds",
      "Red alongside another colour accent on the same surface",
      "More than one red emphasis word per headline",
      "Dark-by-default pages (the brand is paper-led, not ink-led)",
      "Recolouring the bolt mark (black on white or white on ink only)"
    ],
    "alt_accents": {
      "_rule": "Sub-brand or campaign use only. They REPLACE red as the single accent, never sit beside it.",
      "deeper_red": {
        "hex": "#C8102E",
        "name": "Deeper Red",
        "use": "editorial / print"
      },
      "signal_orange": {
        "hex": "#F05A28",
        "name": "Signal Orange",
        "use": "Workforce sub-brand; 3.4:1 on paper, large type only"
      },
      "electric_blue": {
        "hex": "#1F3CFF",
        "name": "Electric Blue",
        "use": "Intelligence sub-brand, product"
      },
      "ink_mono": {
        "hex": "#0B0F14",
        "name": "Ink Mono",
        "use": "mono-colour restraint"
      }
    }
  },
  "typography": {
    "_trio": "Newsreader (display) + DM Sans (UI/body) + JetBrains Mono (system labels). No other webfonts.",
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap",
    "rules": [
      "Display headlines: Newsreader 400 (not bold), line-height 1.04, letter-spacing -0.02em",
      "One italic emphasis word per headline, wrapped in <em>, coloured var(--accent)",
      "UI headings in product surfaces: DM Sans 500",
      "Body: DM Sans 16px, line-height 1.55, colour var(--fg), measure 58–64ch",
      "Eyebrow: DM Sans 12px caps, 0.18em tracking, 24px tick in currentColor, max four words",
      "Mono (JetBrains Mono) for tokens, hex, folios, table numerals; never prose or CTAs",
      "Serif never below 20px; sans never below 12px",
      "Numbers in columns use tabular-nums"
    ]
  },
  "icons": {
    "library": "Lucide",
    "version": "1.66.0",
    "cdn": "https://unpkg.com/lucide@1.66.0/dist/umd/lucide.min.js",
    "library_size": "1,500+",
    "house_curated_count": 69,
    "html_pattern": "<i data-lucide=\"arrow-right\"></i>",
